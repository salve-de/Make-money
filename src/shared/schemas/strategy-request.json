{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/StrategyRequest",
  "definitions": {
    "StrategyRequest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "SYNTHESIZE"
            },
            "selectedEntityIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 50
            },
            "notes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "maxLength": 8000
                  },
                  "updatedAt": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "required": [
                  "content",
                  "updatedAt"
                ],
                "additionalProperties": false
              },
              "maxProperties": 50
            },
            "userProfile": {
              "$ref": "#/definitions/UserProfilePayload"
            }
          },
          "required": [
            "action",
            "selectedEntityIds",
            "notes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "CHAT"
            },
            "conversationId": {
              "type": "string",
              "maxLength": 128
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "user",
                      "assistant"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 8000
                  }
                },
                "required": [
                  "role",
                  "content"
                ],
                "additionalProperties": false
              },
              "maxItems": 50
            },
            "contextEntityId": {
              "type": "string",
              "maxLength": 128
            },
            "synthesizedIdeas": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SynthesizedIdea"
              },
              "maxItems": 20
            },
            "notes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "maxLength": 8000
                  },
                  "updatedAt": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "required": [
                  "content",
                  "updatedAt"
                ],
                "additionalProperties": false
              },
              "maxProperties": 50
            },
            "userProfile": {
              "$ref": "#/definitions/UserProfilePayload"
            }
          },
          "required": [
            "action",
            "messages"
          ],
          "additionalProperties": false
        }
      ]
    },
    "UserProfilePayload": {
      "type": "object",
      "properties": {
        "bookmarkedCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "viewedCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "preferredSectors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "preferredScales": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "averageProfitMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "topTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "topMoats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "profileSummary": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "SynthesizedIdea": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "dimension": {
          "type": "string",
          "enum": [
            "SAVANNA_INSTINCT",
            "META_ARCHITECT",
            "CONTRARIAN_BLINDSPOT"
          ]
        },
        "dimensionLabel": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "targetPainWallet": {
          "type": "string"
        },
        "structuralArbitrage": {
          "type": "string"
        },
        "projectedMonthlyProfitJpy": {
          "type": "number"
        },
        "operatingMargin": {
          "type": "number"
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "monthlyCostJpy": {
                "type": "number"
              },
              "purpose": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "monthlyCostJpy",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "first100TractionPlaybook": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceEntityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "userNoteInspiration": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "dimension",
        "dimensionLabel",
        "title",
        "targetPainWallet",
        "structuralArbitrage",
        "projectedMonthlyProfitJpy",
        "operatingMargin",
        "requiredTools",
        "first100TractionPlaybook",
        "sourceEntityIds",
        "userNoteInspiration"
      ],
      "additionalProperties": false
    }
  }
}
