        "category": {
          "type": "string",
          "enum": [
            "MARKET_DISTORTION",
            "SAVANNAH_PAIN",
            "INCUMBENT_DILEMMA",
            "FOUNDER_HACK",
            "FORUM_RAGE",
            "TECH_VERIFICATION",
            "RESEARCH_LIMIT"
