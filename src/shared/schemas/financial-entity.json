        "model": {
          "type": "string"
        },
        "pricePoint": {
          "type": "string"
        },
        "psychologicalTrigger": {
          "type": "string"
        },
        "estimatedLtvJpy": {
          "type": "number"
        },
        "churnRate": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "pricePoint",
        "psychologicalTrigger"
      ]
    },
    "AcquisitionDossier": {
      "type": "object",
