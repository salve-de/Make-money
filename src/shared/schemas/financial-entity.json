            "decisionSpeedAdvantage": {
              "type": "string"
            }
          },
          "required": [
            "cannibalizationBarrier",
            "scaleMismatchReason",
            "decisionSpeedAdvantage"
          ]
        },
        "pricingPower": {
          "type": "object",
          "properties": {
            "anchorComparison": {
              "type": "string"
            },
            "lossAversionTrigger": {
              "type": "string"
