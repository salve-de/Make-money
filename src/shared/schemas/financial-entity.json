          "required": [
            "anchorComparison",
            "lossAversionTrigger",
            "budgetCategory"
          ]
        },
        "lockInMechanism": {
          "type": "object",
          "properties": {
            "dataHostage": {
              "type": "string"
            },
            "workflowIntegration": {
              "type": "string"
            },
            "switchingFriction": {
              "type": "string"
            }
          },
          "required": [
            "dataHostage",
            "workflowIntegration",
            "switchingFriction"
          ]
