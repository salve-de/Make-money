        "moatDescription": {
          "type": "string"
        },
        "incumbentDilemma": {
          "type": "string"
        },
        "secretInsight": {
          "type": "string"
        },
        "initialTraction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actionPlaybook": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coldOutreachTemplate": {
          "type": "string"
        }
      },
      "required": [
        "blindspot",
        "moatType",
        "moatDescription",
        "initialTraction",
        "actionPlaybook"
      ]
