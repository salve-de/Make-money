    "FinancialEvidenceStatus": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "REPORTED",
        "ESTIMATED",
        "POST_MORTEM",
        "UNAVAILABLE"
      ]
    },
    "SourceClass": {
      "type": "string",
      "enum": [
        "PRIMARY",
        "INDEPENDENT_SECONDARY",
        "COMMUNITY",
        "MODEL"
      ]
    },
    "EvidenceLocator": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pdf"
            },
            "page": {
              "type": "number"
            },
            "table": {
              "type": "string"
            },
            "row": {
              "type": "string"
            },
            "column": {
              "type": "string"
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "type",
            "page"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "html"
            },
            "cssSelector": {
              "type": "string"
            },
            "textHash": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "jsonPointer": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "jsonPointer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "start": {
              "type": "number"
            },
            "end": {
              "type": "number"
            },
            "targetText": {
              "type": "string"
            },
            "excerptHash": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "start",
            "end"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "media"
            },
            "startMs": {
              "type": "number"
            },
            "endMs": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "startMs",
            "endMs"
          ]
        }
      ]
