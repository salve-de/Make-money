    "ExposureAuditDossier": {
      "type": "object",
      "properties": {
        "guerrillaTraction": {
          "type": "string"
        },
        "platformGlitch": {
          "type": "string"
        },
        "pivotSnapshot": {
          "type": "string"
        },
        "hiddenStackCost": {
          "type": "string"
        }
