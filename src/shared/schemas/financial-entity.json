        "viabilityLabel": {
          "type": "string"
        },
        "eraContext": {
          "type": "string"
        },
        "currentViabilityAnalysis": {
          "type": "string"
        }
      },
      "required": [
        "foundedYear",
        "initialTractionPeriod",
        "dataSnapshotPeriod",
        "viabilityStatus",
        "viabilityLabel",
        "eraContext",
        "currentViabilityAnalysis"
