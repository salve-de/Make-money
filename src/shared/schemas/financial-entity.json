            "technicalDifficulty": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "UNKNOWN"
              ]
            },
            "platformRisk": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "CRITICAL",
                "UNKNOWN"
              ]
            }
