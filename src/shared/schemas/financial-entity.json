      "type": "string",
      "enum": [
        "THE_CRIME",
        "SMOKING_GUN",
        "DIRTY_GENESIS",
        "ASYMMETRIC_LEVERAGE",
        "INCUMBENT_TRAP",
        "FATAL_BLEED",
        "LOOT_BLUEPRINT",
        "UNKNOWN_AUDIT"
      ]
    },
    "EvidenceStatus": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "REPORTED",
        "ESTIMATED",
        "POST_MORTEM",
        "UNKNOWN"
      ]
    },
    "TemporalIntelligence": {
      "type": "object",
      "properties": {
        "foundedYear": {
          "type": "number"
        },
        "initialTractionPeriod": {
          "type": "string"
        },
        "dataSnapshotPeriod": {
          "type": "string"
        },
        "viabilityStatus": {
          "$ref": "#/definitions/ViabilityStatus"
