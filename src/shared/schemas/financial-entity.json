        "title": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "evidenceStatus": {
          "$ref": "#/definitions/EvidenceStatus"
        },
        "punchline": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
