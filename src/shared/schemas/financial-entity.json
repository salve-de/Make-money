      "type": "object",
      "properties": {
        "teamSize": {
          "type": "number"
        },
        "isTeamSizeUnconfirmed": {
          "type": "boolean"
        },
        "initialTeamSize": {
          "type": "number"
        },
        "currentTeamSize": {
          "type": "number"
        },
        "weeklyHours": {
          "type": "number"
        },
        "isWeeklyHoursUnconfirmed": {
          "type": "boolean"
        },
        "isCapitalUnconfirmed": {
          "type": "boolean"
        },
        "initialCapitalRequired": {
          "type": "number"
        },
        "automationLevel": {
          "type": "number"
        },
        "isAutomationUnconfirmed": {
          "type": "boolean"
        },
        "primaryChannels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "toolStack": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolStackItem"
          }
        }
