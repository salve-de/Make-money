    "OpportunityJudgment": {
      "type": "object",
      "properties": {
        "verdict": {
          "$ref": "#/definitions/VerdictStatus"
        },
        "verdictLabel": {
          "type": "string"
        },
        "oneLineReason": {
          "type": "string"
        },
        "demandDelta": {
          "type": "string"
        },
        "competitionDelta": {
          "type": "string"
        },
        "entryRequirements": {
          "type": "object",
          "properties": {
            "capital": {
              "type": "string"
