            "max": {
              "type": "number"
            },
            "median": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ]
        }
      },
      "required": [
        "monthlyRevenue",
        "cogs",
        "grossProfit",
        "grossMargin",
        "operatingExpenses",
        "operatingProfit",
        "operatingMargin",
        "estimatedAnnualNetProfit"
      ]
