        },
        "legalEntity": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "sector": {
          "$ref": "#/definitions/SectorCategory"
        },
        "scale": {
          "$ref": "#/definitions/BusinessScale"
        },
        "founder": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "verifiedBadge": {
          "type": "boolean"
        },
        "pnl": {
          "$ref": "#/definitions/ProfitAndLossStatement"
        },
        "operations": {
          "$ref": "#/definitions/OperatingFramework"
        },
        "strategy": {
          "$ref": "#/definitions/StrategicDossier"
        },
        "isGrowthUnconfirmed": {
          "type": "boolean"
        },
        "growthRateYoY": {
          "type": "number"
        },
        "pricing": {
          "$ref": "#/definitions/PricingDossier"
        },
        "acquisition": {
          "$ref": "#/definitions/AcquisitionDossier"
        },
        "essence": {
          "$ref": "#/definitions/BusinessEssence"
        },
        "hasPremiumAnalysis": {
          "type": "boolean"
        },
        "meta": {
          "$ref": "#/definitions/MetaArchitectureDossier"
        },
        "exposureAudit": {
          "$ref": "#/definitions/ExposureAuditDossier"
        },
        "isBookmarked": {
          "type": "boolean"
        },
        "opportunityJudgment": {
          "$ref": "#/definitions/OpportunityJudgment"
        },
        "architecturePattern": {
          "type": "string"
        },
        "pipelineStack": {
          "type": "string"
        },
        "targetPainWallet": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceCards": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DynamicEvidenceCard"
          }
        },
        "temporal": {
          "$ref": "#/definitions/TemporalIntelligence"
        },
        "dynamicMoats": {
          "$ref": "#/definitions/DynamicMoats"
        },
        "observationsStream": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UniversalObservation"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lootBlueprint": {
          "$ref": "#/definitions/LootBlueprint"
        },
        "timelineEvents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UniversalEvent"
          }
        },
        "coverageAudit": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UniversalCoverageItem"
          }
        },
        "unknownsNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishability": {
          "$ref": "#/definitions/PublishabilityStatus"
        },
        "latestDossierHash": {
          "type": "string"
        },
        "sourceRevision": {
          "type": "number"
        },
        "claimBindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClaimEvidenceBinding"
          }
        },
        "batchId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ticker",
        "name",
        "tagline",
        "sector",
        "scale",
        "founder",
        "country",
        "url",
        "verifiedBadge",
        "pnl",
        "operations",
        "strategy",
        "growthRateYoY",
        "architecturePattern",
        "pipelineStack",
        "targetPainWallet",
        "tags"
      ]
    },
    "SectorCategory": {
      "type": "string",
      "enum": [
        "AI_AUTOMATION",
        "NICHE_SAAS",
        "MONOPOLY_MFG",
        "CONTENT_MEDIA",
        "PHYSICAL_ASSET",
        "FINTECH_INFRA",
        "LOCAL_SERVICES",
        "UNKNOWN"
      ]
    },
    "BusinessScale": {
      "type": "string",
      "enum": [
        "SOLO",
        "SMALL_TEAM",
        "SCALEUP",
        "ENTERPRISE",
        "UNKNOWN"
      ]
    },
    "ProfitAndLossStatement": {
      "type": "object",
      "properties": {
        "monthlyRevenue": {
          "type": "number"
        },
        "cogs": {
          "type": "number"
        },
        "grossProfit": {
          "type": "number"
        },
        "grossMargin": {
          "type": "number"
        },
        "operatingExpenses": {
          "type": "object",
          "properties": {
            "serverAndApi": {
              "type": "number"
            },
            "advertising": {
              "type": "number"
            },
            "subcontracting": {
              "type": "number"
            },
            "toolsAndSaaS": {
              "type": "number"
            },
            "other": {
              "type": "number"
            }
          },
          "required": [
            "serverAndApi",
            "advertising",
            "subcontracting",
            "toolsAndSaaS",
            "other"
          ]
        },
        "operatingProfit": {
          "type": "number"
        },
        "operatingMargin": {
          "type": "number"
        },
        "estimatedAnnualNetProfit": {
          "type": "number"
        },
        "isRevenueUnconfirmed": {
          "type": "boolean"
        },
        "isOperatingProfitUnconfirmed": {
          "type": "boolean"
        },
        "isMarginUnconfirmed": {
          "type": "boolean"
        },
        "isGrossProfitUnconfirmed": {
          "type": "boolean"
        },
        "isGrossMarginUnconfirmed": {
          "type": "boolean"
        },
        "isCogsUnconfirmed": {
          "type": "boolean"
        },
        "isCostsUnconfirmed": {
          "type": "boolean"
        },
        "isNetProfitUnconfirmed": {
          "type": "boolean"
        },
        "revenueLabel": {
          "type": "string"
        },
        "financialStatus": {
          "$ref": "#/definitions/FinancialEvidenceStatus"
        },
        "dataSnapshotPeriod": {
          "type": "string"
        },
        "sourceDoc": {
          "type": "string"
        },
        "estimationLogic": {
          "type": "string"
        },
        "sourceClass": {
          "$ref": "#/definitions/SourceClass"
        },
        "evidenceLocator": {
          "$ref": "#/definitions/EvidenceLocator"
        },
        "confidenceScore": {
          "type": "number"
        },
        "estimationRange": {
          "type": "object",
          "properties": {
            "min": {
