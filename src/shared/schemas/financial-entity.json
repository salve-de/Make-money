      "type": "string",
      "enum": [
        "COUNTER_POSITIONING",
        "SWITCHING_COST",
        "NETWORK_EFFECT",
        "CORNERED_RESOURCE",
        "SCALE_ECONOMIES",
        "BRAND_PRESTIGE",
        "PROCESS_POWER",
        "UNKNOWN"
      ]
