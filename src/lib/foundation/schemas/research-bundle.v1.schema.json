{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/salve-de/universal-foundation/schemas/foundation/research-bundle.v1.schema.json",
  "title": "Universal Foundation Research Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "purpose",
    "subject",
    "agent",
    "retrieved_at",
    "sources",
    "evidence",
    "entities",
    "claims",
    "metrics",
    "events",
    "relationships",
    "derived",
    "quality"
  ],
  "properties": {
    "collection_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "status",
          "note"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "found",
              "attempted_unavailable",
              "not_attempted",
              "not_applicable",
              "unknown"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "record_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "origin_type",
          "verification_status",
          "observed_at",
          "collection_channel",
          "observer",
          "text"
        ],
        "properties": {
          "origin_type": {
            "$ref": "#/$defs/originType"
          },
          "verification_status": {
            "$ref": "#/$defs/verificationStatus"
          },
          "observed_at": {
            "$ref": "#/$defs/dateTime"
          },
          "collection_channel": {
            "type": "string",
            "minLength": 1
          },
          "observer": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verification_status": {
                  "const": "SUPPORTED"
                }
              },
              "required": [
                "verification_status"
              ]
            },
            "then": {
              "required": [
                "evidence_ids"
              ],
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "schema_version": {
      "const": "research-bundle.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_.:-]+$"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "make_money",
        "idea_spark",
        "goldmine",
        "investrader",
        "general_research",
        "future_product"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "candidate_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "retrieved_at": {
      "$ref": "#/$defs/dateTime"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "money_signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moneySignal"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "derived": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derived"
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknowns",
        "conflicts",
        "warnings",
        "schema_validation"
      ],
      "properties": {
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_validation": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        }
      }
    }
  },
  "$defs": {
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableDateTime": {
      "anyOf": [
        {
          "$ref": "#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "originType": {
      "type": "string",
      "enum": [
        "reported",
        "observed",
        "estimated",
        "inferred",
        "unknown"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "CONFLICTED",
        "UNVERIFIED",
        "SUPERSEDED",
        "RETRACTED"
      ]
    },
    "sourceStrength": {
      "type": "string",
      "enum": [
        "S",
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "UNRATED"
      ]
    },
    "rightsStatus": {
      "type": "string",
      "enum": [
        "allowed_private_raw",
        "restricted_private_raw",
        "metadata_only",
        "blocked",
        "pending_review"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider_name",
        "source_type",
        "canonical_url",
        "source_strength",
        "rights_status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src\\.[a-z0-9][a-z0-9._-]*$"
        },
        "provider_name": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "source_strength": {
          "$ref": "#/$defs/sourceStrength"
        },
        "rights_status": {
          "$ref": "#/$defs/rightsStatus"
        },
        "rights_policy_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rawStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "captured",
            "restricted",
            "metadata_only",
            "blocked",
            "not_attempted",
            "planned"
          ]
        },
        "bucket": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "source_url",
        "source_title",
        "source_type",
        "publisher_or_speaker",
        "published_at",
        "retrieved_at",
        "source_strength",
        "rights_status",
        "raw_storage",
        "summary"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^ev_[a-f0-9]{24}$"
        },
        "source_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "source_title": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "publisher_or_speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "retrieved_at": {
          "$ref": "#/$defs/dateTime"
        },
        "source_strength": {
          "$ref": "#/$defs/sourceStrength"
        },
        "rights_status": {
          "$ref": "#/$defs/rightsStatus"
        },
        "rights_policy_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_storage": {
          "$ref": "#/$defs/rawStorage"
        },
        "summary": {
          "type": "string"
        },
        "extracted_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "canonical_name",
        "aliases",
        "canonical_identifier",
        "status",
        "observed_at"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^ent_[a-z0-9]+_[a-f0-9]{20}$"
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "canonical_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "entity_ids",
        "statement",
        "origin_type",
        "verification_status",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^cl_[a-f0-9]{24}$"
        },
        "entity_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "origin_type": {
          "$ref": "#/$defs/originType"
        },
        "verification_status": {
          "$ref": "#/$defs/verificationStatus"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "occurred_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "valid_from": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "valid_to": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "entity_id",
        "metric_type",
        "value",
        "unit",
        "currency",
        "period_start",
        "period_end",
        "point_in_time",
        "basis",
        "scope",
        "origin_type",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^mt_[a-f0-9]{24}$"
        },
        "entity_id": {
          "type": "string"
        },
        "metric_type": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "period_start": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "period_end": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "point_in_time": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin_type": {
          "$ref": "#/$defs/originType"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "verification_status": {
          "$ref": "#/$defs/verificationStatus"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "moneySignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "money_signal_id",
        "payer_entity_id",
        "receiver_entity_id",
        "purpose",
        "money_type",
        "amount",
        "currency",
        "period_start",
        "period_end",
        "point_in_time",
        "basis",
        "scope",
        "origin_type",
        "verification_status",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "money_signal_id": {
          "type": "string",
          "pattern": "^ms_[a-f0-9]{24}$"
        },
        "payer_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "receiver_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "money_type": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "period_start": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "period_end": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "point_in_time": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin_type": {
          "$ref": "#/$defs/originType"
        },
        "verification_status": {
          "$ref": "#/$defs/verificationStatus"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "entity_ids",
        "event_type",
        "occurred_at",
        "description",
        "verification_status",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^evt_[a-f0-9]{24}$"
        },
        "entity_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "$ref": "#/$defs/verificationStatus"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "subject_entity_id",
        "predicate",
        "object",
        "verification_status",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "relationship_id": {
          "type": "string",
          "pattern": "^rel_[a-f0-9]{24}$"
        },
        "subject_entity_id": {
          "type": "string"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "valid_to": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "verification_status": {
          "$ref": "#/$defs/verificationStatus"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_id",
        "derived_type",
        "text",
        "origin_type",
        "confidence",
        "supporting_claim_ids",
        "supporting_evidence_ids"
      ],
      "properties": {
        "derived_id": {
          "type": "string",
          "pattern": "^drv_[a-f0-9]{24}$"
        },
        "derived_type": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "origin_type": {
          "const": "inferred"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "supporting_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    }
  }
}
