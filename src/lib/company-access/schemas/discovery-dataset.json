{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DiscoveryDataset",
  "definitions": {
    "DiscoveryDataset": {
      "type": "object",
      "properties": {
        "sourceCount": {
          "type": "number"
        },
        "visibleCount": {
          "type": "number"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiscoveryCase"
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiscoveryCase"
          }
        }
      },
      "required": [
        "sourceCount",
        "visibleCount",
        "cases",
        "highlights"
      ]
    },
    "DiscoveryCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "sector": {
          "type": "string",
          "description": "SEC の標準産業分類（SEC_SIC）が根拠の時だけ入る。それ以外は空文字で、画面に出さない。"
        },
        "resultLabel": {
          "type": "string"
        },
        "resultValue": {
          "type": "string"
        },
        "resultAmountJpy": {
          "type": [
            "number",
            "null"
          ]
        },
        "resultMetricId": {
          "type": [
            "string",
            "null"
          ]
        },
        "summaryFactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "summaryText": {
          "type": "string"
        },
        "resultEvidenceLabel": {
          "type": "string"
        },
        "resultPeriod": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultSource": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultPeriodNote": {
          "type": [
            "string",
            "null"
          ]
        },
        "startLine": {
          "type": "string"
        },
        "criticalInsight": {
          "type": "string"
        },
        "whyMoneyMoved": {
          "type": "string"
        },
        "leverage": {
          "type": "string"
        },
        "currentLabel": {
          "type": "string"
        },
        "currentDetail": {
          "type": "string"
        },
        "isCurrent": {
          "type": "boolean"
        },
        "isFailure": {
          "type": "boolean"
        },
        "isSolo": {
          "type": "boolean"
        },
        "lowCapital": {
          "type": "boolean"
        },
        "lowWork": {
          "type": "boolean"
        },
        "evidenceCount": {
          "type": "number"
        },
        "descriptors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "scores": {
          "type": "object",
          "properties": {
            "SURPRISE": {
              "type": "number"
            },
            "BIG_CASH": {
              "type": "number"
            },
            "LOW_CAPITAL": {
              "type": "number"
            },
            "SOLO": {
              "type": "number"
            },
            "LOW_WORK": {
              "type": "number"
            },
            "CURRENT": {
              "type": "number"
            },
            "FAILURE": {
              "type": "number"
            }
          },
          "required": [
            "SURPRISE",
            "BIG_CASH",
            "LOW_CAPITAL",
            "SOLO",
            "LOW_WORK",
            "CURRENT",
            "FAILURE"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "tagline",
        "sector",
        "resultLabel",
        "resultValue",
        "resultAmountJpy",
        "resultMetricId",
        "summaryFactId",
        "summaryText",
        "resultEvidenceLabel",
        "resultPeriod",
        "resultSource",
        "resultPeriodNote",
        "startLine",
        "criticalInsight",
        "whyMoneyMoved",
        "leverage",
        "currentLabel",
        "currentDetail",
        "isCurrent",
        "isFailure",
        "isSolo",
        "lowCapital",
        "lowWork",
        "evidenceCount",
        "descriptors",
        "scores"
      ]
    }
  }
}
