{
  "name": "make-money-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/architecture/check-paid-bundle.mjs",
    "start": "next start",
    "lint": "eslint && node scripts/architecture/check-boundaries.mjs && node scripts/architecture/check-storage.mjs && node scripts/architecture/check-api-input.mjs && node scripts/architecture/check-runtime-schema.mjs",
    "preview:workers": "pnpm workers:build && opennextjs-cloudflare preview",
    "deploy:preflight": "node scripts/architecture/check-deploy-config.mjs",
    "deploy:workers": "pnpm deploy:preflight && pnpm workers:build && opennextjs-cloudflare deploy",
    "upload:workers": "pnpm deploy:preflight && pnpm workers:build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "r2:with-secrets": "node scripts/with-r2-keychain-secrets.mjs",
    "foundation:r2": "node scripts/with-r2-keychain-secrets.mjs node --import tsx scripts/foundation-collect.ts ingest",
    "foundation:index": "node --import tsx scripts/generate-entities-index.ts",
    "foundation:journal:prepare": "node --import tsx scripts/foundation-journal.ts prepare",
    "foundation:journal:ingest": "node --import tsx scripts/foundation-journal.ts ingest",
    "foundation:r2-descriptors:prepare": "node --import tsx scripts/foundation-r2-descriptors.ts prepare",
    "foundation:r2-descriptors:ingest": "node --import tsx scripts/foundation-r2-descriptors.ts ingest",
    "typecheck": "next typegen && tsc --noEmit && pnpm schemas:check",
    "test": "vitest run && pnpm test:foundation && pnpm test:architecture && pnpm test:recovery",
    "test:architecture": "node --test scripts/architecture/check-deploy-config.test.mjs scripts/architecture/check-worker-secrets.test.mjs scripts/architecture/check-api-input.test.mjs scripts/architecture/check-runtime-schema.test.mjs",
    "test:foundation": "node --import tsx --test scripts/*.test.ts",
    "test:e2e": "playwright test",
    "schemas:generate": "node scripts/architecture/generate-schemas.mjs",
    "schemas:check": "node scripts/architecture/generate-schemas.mjs --check",
    "db:migrate:local": "wrangler d1 migrations apply APP_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply APP_DB --remote",
    "test:recovery": "python3 scripts/architecture/verify-d1-recovery.py && python3 -m unittest discover -s scripts/architecture -p 'test_*.py'",
    "workers:build": "node scripts/architecture/build-workers.mjs",
    "bundle:workers": "pnpm workers:build -- --skipNextBuild"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@cfworker/json-schema": "4.1.1",
    "@next/env": "16.3.4",
    "@opennextjs/cloudflare": "^1.20.6",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "firebase": "^12.18.0",
    "jose": "^6.2.12",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "ts-json-schema-generator": "2.9.0",
    "tsx": "4.20.5",
    "typescript": "^5",
    "vitest": "5.0.0",
    "wrangler": "^4.129.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@8.10.0+sha512.9c2cb83f2b6cf6a25d8c58300bf99197c7ef3be84cf3e766f29054b40b83b42f8aaba6fcc314a9ecf27c00f7ce80a757bb4c608800e7adbe2d29dc5c7056f5be"
}
