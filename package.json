{
  "name": "make-money-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "catalog:prepare": "node --import tsx scripts/prepare-catalog-release.ts",
    "evidence:attest": "node --import tsx scripts/reader-case/attest-evidence.ts",
    "evidence:check": "node --import tsx scripts/reader-case/attest-evidence.ts --check",
    "catalog:check": "node --import tsx scripts/prepare-catalog-release.ts --check",
    "catalog:screen-check": "tsx scripts/architecture/screen-text.tsx --check",
    "catalog:audit": "node --import tsx scripts/audit-catalog-coverage.ts",
    "catalog:publish": "pnpm catalog:screen-check && pnpm evidence:check && pnpm catalog:prepare && node scripts/with-r2-keychain-secrets.mjs node --import tsx scripts/publish-catalog-release.ts",
    "foundation:snapshots": "node scripts/foundation/build-foundation-snapshots.mjs",
    "foundation:snapshots:check": "node scripts/foundation/build-foundation-snapshots.mjs --check",
    "predev": "node --import tsx scripts/ensure-local-catalog.ts",
    "dev": "next dev",
    "build": "pnpm lint && next build --webpack && node scripts/architecture/check-paid-bundle.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint --max-warnings=0 && node scripts/architecture/check-boundaries.mjs && node scripts/architecture/check-storage.mjs && node scripts/architecture/check-api-input.mjs && node scripts/architecture/check-runtime-schema.mjs && node scripts/architecture/check-index-safety.mjs && node scripts/architecture/check-ingest-quality.mjs && node scripts/architecture/check-template-prose.mjs && node scripts/architecture/check-case-text-standard.mjs && node --import tsx scripts/case-pages/build.ts --check && node scripts/architecture/check-component-health.mjs",
    "ingest:verify": "node scripts/architecture/check-ingest-quality.mjs",
    "case-pages:build": "node --import tsx scripts/case-pages/build.ts",
    "case-pages:check": "node --import tsx scripts/case-pages/build.ts --check",
    "case-text:verify": "node scripts/architecture/check-case-text-standard.mjs",
    "natural-ja:report": "node scripts/architecture/report-natural-japanese.mjs",
    "case-chapters:todo": "node --import tsx scripts/reader-case/chapter-gaps.ts",
    "case:run": "node --import tsx scripts/reader-case/case-run.ts",
    "case:discover": "node --import tsx scripts/reader-case/case-discover.ts",
    "case:research": "node --import tsx scripts/reader-case/case-research.ts",
    "display:build": "node --import tsx scripts/reader-case/build-display.ts",
    "fact-lines:build": "node --import tsx scripts/reader-case/build-fact-lines.ts",
    "template-prose:verify": "node scripts/architecture/check-template-prose.mjs",
    "rights:seed": "node --import tsx scripts/rights/seed.ts",
    "rights:where": "node --import tsx scripts/rights/where.ts",
    "rights:suspend": "node --import tsx scripts/rights/suspend.ts suspend",
    "rights:resume": "node --import tsx scripts/rights/suspend.ts resume",
    "rights:review": "node --import tsx scripts/rights/review.ts",
    "rights:terms": "node --import tsx scripts/rights/terms-snapshot.ts",
    "decisions:check": "node scripts/decisions/check-owner-decisions.mjs",
    "daily:run": "node --import tsx scripts/daily/daily-run.ts",
    "pipeline:daily": "bash scripts/reader-case/run-daily.sh",
    "pipeline:status": "node --import tsx scripts/reader-case/pipeline-status.ts",
    "ingest:incoming": "npx tsx scripts/pipeline/process-incoming.ts",
    "audit:ui": "tsx scripts/architecture/audit-all-234-ui.ts",
    "preview:workers": "pnpm workers:build && opennextjs-cloudflare preview",
    "deploy:preflight": "node scripts/architecture/check-deploy-config.mjs && node scripts/architecture/check-rights-upstream-release.mjs && node scripts/architecture/check-public-fact-upstream-release.mjs",
    "deploy:workers": "pnpm deploy:preflight && pnpm db:migrate:remote && pnpm catalog:publish && pnpm workers:build && opennextjs-cloudflare deploy",
    "upload:workers": "pnpm deploy:preflight && pnpm catalog:publish && pnpm workers:build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "r2:with-secrets": "node scripts/with-r2-keychain-secrets.mjs",
    "foundation:r2": "node scripts/with-r2-keychain-secrets.mjs node --import tsx scripts/foundation-collect.ts ingest",
    "r2:queue:materialize": "node --import tsx scripts/r2-queue-materialize.ts",
    "foundation:index": "node --import tsx scripts/generate-entities-index.ts",
    "foundation:journal:prepare": "node --import tsx scripts/foundation-journal.ts prepare",
    "foundation:journal:ingest": "node --import tsx scripts/foundation-journal.ts ingest",
    "foundation:r2-descriptors:prepare": "node --import tsx scripts/foundation-r2-descriptors.ts prepare",
    "foundation:audit": "node scripts/with-r2-keychain-secrets.mjs npx tsx scripts/audit-r2-integrity.ts",
    "r2:100-year:audit": "node scripts/r2-100-year-audit.mjs",
    "r2:100-year:canary": "node scripts/with-r2-keychain-secrets.mjs node --import tsx scripts/r2-create-only-canary.ts",
    "r2:100-year:restore": "node scripts/with-r2-keychain-secrets.mjs node --import tsx scripts/r2-restore-check.ts",
    "r2:writer:check": "wrangler deploy --config wrangler.r2-writer.jsonc --dry-run",
    "r2:writer:dev": "wrangler dev --config wrangler.r2-writer.jsonc",
    "r2:writer:deploy": "wrangler deploy --config wrangler.r2-writer.jsonc --var FOUNDATION_R2_WRITER_ENABLED:true",
    "ingest:daemon": "node scripts/with-r2-keychain-secrets.mjs npx tsx scripts/pipeline/autonomous-ingest-daemon.ts",
    "registry:sync": "node scripts/sync-registry.mjs",
    "dedup:check": "node scripts/check-dedup.mjs",
    "prompt:collect": "node scripts/generate-collection-prompt.mjs",
    "typecheck": "next typegen && tsc --noEmit && pnpm schemas:check",
    "test": "vitest run && pnpm test:foundation && pnpm test:runner && pnpm test:daily && pnpm test:architecture && pnpm test:recovery",
    "test:architecture": "node --test scripts/architecture/check-deploy-config.test.mjs scripts/architecture/check-rights-upstream-release.test.mjs scripts/architecture/check-public-fact-upstream-release.test.mjs scripts/architecture/check-worker-secrets.test.mjs scripts/architecture/check-api-input.test.mjs scripts/architecture/check-runtime-schema.test.mjs scripts/architecture/check-index-safety.test.mjs scripts/architecture/ingest-hazard-guard.test.mjs scripts/ops/check-freshness.test.mjs scripts/architecture/natural-japanese.test.mjs scripts/architecture/reader-clarity.test.mjs scripts/reader-view/rules.test.mjs scripts/reader-view/structure-rules.test.mjs scripts/decisions/owner-decisions.test.mjs scripts/reader-case/display-build-parallel.test.mjs",
    "test:daily": "node --import tsx --test scripts/daily/*.test.ts",
    "test:runner": "node --import tsx --test scripts/reader-case/runner/*.test.ts",
    "test:foundation": "node --import tsx --test scripts/*.test.ts && node --test scripts/gemini-*.test.mjs scripts/openai-*.test.mjs",
    "test:e2e": "playwright test",
    "reader-view:audit": "playwright test e2e/reader-view-audit.spec.ts",
    "schemas:generate": "node scripts/architecture/generate-schemas.mjs",
    "schemas:check": "node scripts/architecture/generate-schemas.mjs --check",
    "db:migrate:local": "wrangler d1 migrations apply APP_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply APP_DB --remote",
    "test:recovery": "python3 scripts/architecture/verify-d1-recovery.py && python3 -m unittest discover -s scripts/architecture -p 'test_*.py'",
    "workers:build": "node scripts/architecture/build-workers.mjs",
    "bundle:workers": "pnpm workers:build -- --skipNextBuild",
    "foundation:typed:preflight": "node --import tsx scripts/foundation-typed-preflight.ts",
    "foundation:rights:audit": "node scripts/with-r2-keychain-secrets.mjs node --import tsx scripts/audit-commercial-rights-r2.ts",
    "ui:audit": "node scripts/ui-audit/capture.mjs",
    "text:templates": "node --import tsx scripts/text/build-template-phrases.ts",
    "display:build:parallel": "node scripts/reader-case/display-build-parallel.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@cfworker/json-schema": "4.1.1",
    "@next/env": "16.3.6",
    "@opennextjs/cloudflare": "^1.20.6",
    "@xyflow/react": "^12.11.6",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "echarts": "^6.1.0",
    "firebase": "^12.18.0",
    "jose": "^6.2.12",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "textlint": "15.8.0",
    "textlint-rule-ja-no-abusage": "3.0.0",
    "textlint-rule-ja-no-redundant-expression": "4.0.1",
    "textlint-rule-ja-unnatural-alphabet": "2.0.1",
    "textlint-rule-max-ten": "5.0.0",
    "textlint-rule-no-double-negative-ja": "2.0.1",
    "textlint-rule-no-doubled-conjunction": "3.0.1",
    "textlint-rule-no-doubled-conjunctive-particle-ga": "3.0.0",
    "textlint-rule-no-dropping-the-ra": "3.0.0",
    "textlint-rule-no-hankaku-kana": "2.0.1",
    "textlint-rule-no-nfd": "2.0.2",
    "textlint-rule-no-zero-width-spaces": "1.0.1",
    "ts-json-schema-generator": "2.9.0",
    "tsx": "4.20.5",
    "typescript": "^5",
    "vitest": "5.0.0",
    "wrangler": "^4.129.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4",
      "proxy-addr": ">=2.0.8"
    }
  },
  "packageManager": "pnpm@8.10.0+sha512.9c2cb83f2b6cf6a25d8c58300bf99197c7ef3be84cf3e766f29054b40b83b42f8aaba6fcc314a9ecf27c00f7ce80a757bb4c608800e7adbe2d29dc5c7056f5be"
}
