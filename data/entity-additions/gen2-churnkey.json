   "record": {
    "id": "ent_churnkey_8d7f2b269c21",
    "ticker": "CHURNKEY",
    "name": "Churnkey",
    "legalEntity": "Churnkey, Inc.（公式サイト表記）",
    "tagline": "解約時の休止提案と失敗した決済の回収を、定額で継続課金事業へ提供する。",
    "description": "Wavve の解約問題への対処から生まれた、継続課金事業向けの解約防止と決済回収の仕組み。2020年9月に先行利用を告知した。",
    "sector": "NICHE_SAAS",
