     },
     {
      "id": "df-036",
      "kind": "DESCRIPTION",
      "text": "説明文と商品を直し、顧客が増えても対応の件数を1日3件から2件へ減らしたと申告。",
      "sourceUrl": "https://www.starterstory.com/stories/data-fetcher",
      "statedAt": null,
      "checkedAt": "2026-10-07",
      "eventPeriod": "2024年の回顧、比較期間未確認",
      "informationDomain": "日常運営",
      "attribution": "公開されている取材本文の創業者申告"
     },
     {
      "id": "df-037",
      "kind": "DESCRIPTION",
      "text": "接続先が40以上になり保守が重く、接続を増やす判断を慎重にしたと説明。",
      "sourceUrl": "https://www.starterstory.com/stories/data-fetcher",
      "statedAt": null,
      "checkedAt": "2026-10-07",
      "eventPeriod": "2024年の取材時点",
      "informationDomain": "転機・失敗・外部条件・依存リスク",
      "attribution": "公開されている取材本文の創業者申告"
     },
     {
      "id": "df-038",
      "kind": "DESCRIPTION",
      "text": "Airtable の機能・料金の変更と実行回数制限により新規登録が減ったと説明。",
      "sourceUrl": "https://www.starterstory.com/stories/data-fetcher",
      "statedAt": null,
      "checkedAt": "2026-10-07",
      "eventPeriod": "2023〜2024年の回顧",
      "informationDomain": "転機・失敗・外部条件・依存リスク",
      "attribution": "公開されている取材本文の創業者申告"
     },
     {
      "id": "df-039",
      "kind": "DESCRIPTION",
      "text": "2022年3月の本文では有料客190人、MRR USD 6,500。見出しの USD 23,000 をこの時点の売上に使わない。",
      "sourceUrl": "https://www.starterstory.com/stories/how-i-built-an-airtable-plugin-will-lets-users-visualize-and-manage-their-data-better-60k-year",
      "statedAt": "2022-03-07",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2022年3月",
      "informationDomain": "売れた実績",
      "attribution": "取材本文の創業者申告。更新された見出しと区別"
     },
     {
      "id": "df-040",
      "kind": "DESCRIPTION",
      "text": "以前の Influence Grid は MRR USD 3,000 へ育て USD 55,000 で売却。代金を生活費・ドメイン・Heroku に使ったと説明。新事業の初期費用総額ではない。",
      "sourceUrl": "https://www.starterstory.com/stories/how-i-built-an-airtable-plugin-will-lets-users-visualize-and-manage-their-data-better-60k-year",
      "statedAt": "2022-03-07",
      "checkedAt": "2026-10-07",
      "eventPeriod": "Data Fetcher 開始前〜初期",
      "informationDomain": "開始資源",
      "attribution": "取材本文の創業者申告。更新された見出しと区別"
     },
     {
      "id": "df-041",
      "kind": "DESCRIPTION",
      "text": "初版開発に1か月、審査にさらに3か月かかったと回顧。開発は本人が行い主な投資は時間だったと説明。",
      "sourceUrl": "https://www.starterstory.com/stories/how-i-built-an-airtable-plugin-will-lets-users-visualize-and-manage-their-data-better-60k-year",
      "statedAt": "2022-03-07",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2020年の回顧",
      "informationDomain": "開始資源",
      "attribution": "取材本文の創業者申告。更新された見出しと区別"
     },
     {
      "id": "df-042",
      "kind": "DESCRIPTION",
      "text": "Twitter で開発を伝えて案内ページにメールを集め、公開時に通知し Airtable の集まりへ投稿。最初の2週間で客を得たと説明。",
      "sourceUrl": "https://www.starterstory.com/stories/how-i-built-an-airtable-plugin-will-lets-users-visualize-and-manage-their-data-better-60k-year",
      "statedAt": "2022-03-07",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2020年11月の公開時",
      "informationDomain": "最初の需要と購入の実経緯",
      "attribution": "取材本文の創業者申告。更新された見出しと区別"
     },
     {
      "id": "df-043",
      "kind": "DESCRIPTION",
      "text": "2022年3月時点は客の70〜80%が売り場、約20%が記事・動画経由。無料利用者の約10%が課金すると本人が説明。",
      "sourceUrl": "https://www.starterstory.com/stories/how-i-built-an-airtable-plugin-will-lets-users-visualize-and-manage-their-data-better-60k-year",
      "statedAt": "2022-03-07",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2022年3月",
      "informationDomain": "その後の集客と購入・継続",
      "attribution": "取材本文の創業者申告。更新された見出しと区別"
     },
     {
      "id": "df-044",
      "kind": "DESCRIPTION",
      "text": "サーバーと道具は月約 USD 500、本人給与前の利益率約90%と表現。給与・外注・税等の全費用を含む純利益とは扱わない。",
      "sourceUrl": "https://www.starterstory.com/stories/how-i-built-an-airtable-plugin-will-lets-users-visualize-and-manage-their-data-better-60k-year",
      "statedAt": "2022-03-07",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2022年3月",
      "informationDomain": "利益と費用",
      "attribution": "取材本文の創業者申告。更新された見出しと区別"
     },
     {
      "id": "df-045",
      "kind": "DESCRIPTION",
      "text": "Mailerlite、SendGrid、Airtable、GitBook、GraphCMS を運営に使用。GitBook と GraphCMS は無料枠と説明。",
      "sourceUrl": "https://www.starterstory.com/stories/how-i-built-an-airtable-plugin-will-lets-users-visualize-and-manage-their-data-better-60k-year",
      "statedAt": "2022-03-07",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2022年3月",
      "informationDomain": "日常運営",
      "attribution": "取材本文の創業者申告。更新された見出しと区別"
     },
     {
      "id": "df-046",
      "kind": "DESCRIPTION",
      "text": "外部投資は受けていないと説明した。",
      "sourceUrl": "https://www.starterstory.com/stories/how-i-built-an-airtable-plugin-will-lets-users-visualize-and-manage-their-data-better-60k-year",
      "statedAt": "2022-03-07",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2022年3月",
      "informationDomain": "開始資源",
      "attribution": "取材本文の創業者申告。更新された見出しと区別"
     },
     {
      "id": "df-047",
      "kind": "DESCRIPTION",
      "text": "見込み客の約50%は Airtable の売り場経由と発言。2022年の購入客の割合とは分母が違う。",
      "sourceUrl": "https://www.napierb2b.com/2025/09/unlocking-data-how-to-simplify-data-integrations-data-fetcher-andy-cloke/",
      "statedAt": "2025-09-17",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2025年9月",
      "informationDomain": "その後の集客と購入・継続",
      "attribution": "公開された対談の創業者発言"
     },
     {
      "id": "df-048",
      "kind": "DESCRIPTION",
      "text": "具体的な取り込み方の記事と対になる YouTube 動画を作り、数百視聴でも約10人の客につながる例があると説明。",
      "sourceUrl": "https://www.napierb2b.com/2025/09/unlocking-data-how-to-simplify-data-integrations-data-fetcher-andy-cloke/",
      "statedAt": "2025-09-17",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2025年9月の説明",
      "informationDomain": "その後の集客と購入・継続",
      "attribution": "公開された対談の創業者発言"
     },
     {
      "id": "df-049",
      "kind": "DESCRIPTION",
      "text": "Make・Zapier のように別の画面へ移らず、Airtable の中で取り込みを完結できる点を説明した。",
      "sourceUrl": "https://www.napierb2b.com/2025/09/unlocking-data-how-to-simplify-data-integrations-data-fetcher-andy-cloke/",
      "statedAt": "2025-09-17",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2025年9月",
      "informationDomain": "顧客と困りごと",
      "attribution": "公開された対談の創業者発言"
     },
     {
      "id": "df-050",
      "kind": "DESCRIPTION",
      "text": "自身も広告・検索・YouTube の数値を Airtable に集める運用をしていると説明。",
      "sourceUrl": "https://www.napierb2b.com/2025/09/unlocking-data-how-to-simplify-data-integrations-data-fetcher-andy-cloke/",
      "statedAt": "2025-09-17",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2025年9月",
      "informationDomain": "日常運営",
      "attribution": "公開された対談の創業者発言"
     },
     {
      "id": "df-051",
      "kind": "DESCRIPTION",
      "text": "開始時は売り場審査が数か月、対談時点は更新審査が速くなったと説明。monday.com は仕組みの変更・不安定さで続けなかったと述べた。",
      "sourceUrl": "https://www.napierb2b.com/2025/09/unlocking-data-how-to-simplify-data-integrations-data-fetcher-andy-cloke/",
      "statedAt": "2025-09-17",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2020年と2025年の比較",
      "informationDomain": "転機・失敗・外部条件・依存リスク",
      "attribution": "公開された対談の創業者発言"
     },
     {
      "id": "df-052",
      "kind": "DESCRIPTION",
      "text": "Paul T. は対応の速さと柔軟さを評価する一方、高度な要求や連続処理では学習と何度かの試行が必要と記載。",
      "sourceUrl": "https://www.g2.com/products/data-fetcher/reviews",
      "statedAt": "2025-07-29",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2025-07-29",
      "informationDomain": "顧客と困りごと",
      "attribution": "各利用者の主観的な投稿。公開部分のみ",
      "evidenceLocator": "Paul T. の投稿"
     },
     {
      "id": "df-053",
      "kind": "DESCRIPTION",
      "text": "非営利団体の利用者は外部名簿の取り込みと対応を評価し、独自接続だけでなく用意済みの接続を増やしてほしいと記載。",
      "sourceUrl": "https://www.g2.com/products/data-fetcher/reviews",
      "statedAt": "2024-07-26",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2024-07-26",
      "informationDomain": "顧客と困りごと",
      "attribution": "各利用者の主観的な投稿。公開部分のみ",
      "evidenceLocator": "非営利団体の利用者の投稿"
     },
     {
      "id": "df-054",
      "kind": "DESCRIPTION",
      "text": "Grant E. はプログラミングができなくてもデータを使う副事業を作れたと投稿。売上額や事業の採算は未確認。",
      "sourceUrl": "https://www.g2.com/products/data-fetcher/reviews",
      "statedAt": "2024-10-06",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2024-10-06",
      "informationDomain": "顧客と困りごと",
      "attribution": "各利用者の主観的な投稿。公開部分のみ",
      "evidenceLocator": "Grant E. の投稿"
     },
     {
      "id": "df-055",
      "kind": "DESCRIPTION",
      "text": "建築・計画分野の利用者は、Data Fetcher と接続先の双方に定期料金があることを負担として挙げた。",
      "sourceUrl": "https://www.g2.com/products/data-fetcher/reviews",
      "statedAt": "2024-03-05",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2024-03-05",
      "informationDomain": "顧客と困りごと",
      "attribution": "各利用者の主観的な投稿。公開部分のみ",
      "evidenceLocator": "建築・計画分野の利用者の投稿"
     },
     {
      "id": "df-056",
      "kind": "DESCRIPTION",
      "text": "初掲載は2020年12月15日、2.0 の掲載は2022年2月24日。2021年12月の製品改版とは別の出来事。",
      "sourceUrl": "https://www.producthunt.com/products/data-fetcher-for-airtable",
      "statedAt": null,
      "checkedAt": "2026-10-07",
      "eventPeriod": "2020年12月・2022年2月",
      "informationDomain": "その後の集客と購入・継続",
      "attribution": "公開された製品の掲載日"
     },
     {
      "id": "df-057",
      "kind": "DESCRIPTION",
      "text": "最終更新表示は2025年4月10日。料金は返金不可、随時解約し支払済み期間は使えると記載。",
      "sourceUrl": "https://datafetcher.com/terms",
      "statedAt": "2025-04-10",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2026-10-07確認",
      "informationDomain": "商品と売り方",
      "attribution": "公式規約の表示。法的評価はしていない"
     },
     {
      "id": "df-058",
      "kind": "DESCRIPTION",
      "text": "顧客データの所有は顧客にあり、サービス提供者は所有権を主張しないと記載。",
      "sourceUrl": "https://datafetcher.com/terms",
      "statedAt": "2025-04-10",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2025年4月更新、2026-10-07確認",
      "informationDomain": "商品と売り方",
      "attribution": "公式規約の表示。法的評価はしていない"
     },
     {
      "id": "df-059",
      "kind": "DESCRIPTION",
      "text": "停止や中断があり得る条件と可用性保証をしない旨がある。取り込んだデータは利用者が確認する条件。",
      "sourceUrl": "https://datafetcher.com/terms",
      "statedAt": "2025-04-10",
      "checkedAt": "2026-10-07",
      "eventPeriod": "2025年4月更新、2026-10-07確認",
      "informationDomain": "転機・失敗・外部条件・依存リスク",
      "attribution": "公式規約の表示。法的評価はしていない"
     },
     {
      "id": "df-060",
      "kind": "DESCRIPTION",
      "text": "Fox Logistics は業務の自動化後、人数を増やさず週の出荷1,800件から2,500件になったと紹介。Data Fetcher 単体の因果効果を検証した数値ではない。",
      "sourceUrl": "https://datafetcher.com/customers/fox-logistics",
      "statedAt": null,
      "checkedAt": "2026-10-07",
      "eventPeriod": "掲載時点不明、2026-10-07確認",
      "informationDomain": "顧客と困りごと",
      "attribution": "販売者が掲載する顧客の証言。独立検証なし"
     },
     {
      "id": "df-061",
      "kind": "DESCRIPTION",
      "text": "顧客の用途として、450か所の歯科診療所のデータ管理、約400人の宣教師の管理、従業員の工数・人事データの統合を掲載。各組織の人数は販売者の紹介。",
      "sourceUrl": "https://datafetcher.com/customers",
