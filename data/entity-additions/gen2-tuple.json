   "record": {
    "id": "ent_tuple_20261007",
    "ticker": "TUPLE",
    "name": "Tuple",
    "legalEntity": "Tuple, LLC（公式サイトの著作権表記）",
    "tagline": "離れた開発者が同じ画面を操作できるソフト。完成前に年契約を売り、招待制から組織内の共同開発へ広げた",
    "description": "開発者向けに高精細の画面共有、音声、遠隔操作を提供する。2018年に創業し、2019年1月に初期版を招待制で提供した。2020年の障害から基盤と品質検査を整え、Windows 版や端末内の記録機能へ展開した。",
    "sector": "NICHE_SAAS",
    "scale": "UNKNOWN",
    "founder": "Ben Orenstein、Joel、Spencer（本人取材に登場する共同創業者）",
    "country": "",
    "url": "https://tuple.app/",
    "officialUrl": "https://tuple.app/",
    "verifiedBadge": false,
    "growthRateYoY": 0,
    "architecturePattern": "開発チームへ1人あたりの月額利用料で画面共有と共同操作を提供し、大企業は個別契約で扱う。",
    "pipelineStack": "",
