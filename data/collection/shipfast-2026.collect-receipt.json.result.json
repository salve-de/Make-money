{
  "collection_policy": {
    "schema_version": "collection-profile.v2",
    "profile_id": "business_case",
    "status": "target_for_new_collectors",
    "principle": "Collection profiles define what to attempt, never what Foundation is allowed to retain. Preserve every materially relevant discovered observation even outside this profile.",
    "tiers": {
      "CAPTURE": {
        "purpose": "Retain a useful lead immediately without requiring deep completion.",
        "minimum": [
          "subject_identity_or_description",
          "observation_or_lead",
          "observed_or_recorded_time",
          "origin_and_verification_state"
        ],
        "completion_label": "CAPTURED_PARTIAL"
      },
      "CORE": {
        "purpose": "Attempt broadly reusable business dimensions before product-specific enrichment.",
        "domains": [
          "identity",
          "people",
          "product",
          "customer_and_demand",
          "pricing",
          "money_and_economics",
          "distribution",
          "operations",
          "technology",
          "competition_and_market",
          "timeline_and_outcomes",
          "provenance_rights_and_uncertainty"
        ],
        "completion_label": "CORE_ATTEMPTED"
      },
      "ENRICHED": {
        "purpose": "Follow evidence, promising signals, and consumer-specific needs without treating consumer UI fields as universal facts.",
        "completion_label": "ENRICHED"
      },
      "DEEP_RECONCILED": {
        "purpose": "Claim deep completeness only within a declared scope after source inventory and retained-record reconciliation.",
        "detailed_checklist_ref": "registry/collection/business-case.v1.json",
        "reconciliation_contract": "docs/COLLECTION_RECONCILIATION.md",
        "completion_label": "RECONCILED_WITHIN_SCOPE"
      }
    },
    "priority_information": [
      "who_or_what",
      "what_is_sold_or_done",
      "who_pays_and_why",
      "payer_receiver_purpose_and_money_flow",
      "revenue_profit_cost_price_and_margin",
      "distribution_and_first_customers",
      "operating_burden_and_automation",
      "technology_and_dependencies",
      "competition_substitutes_and_market_change",
      "success_failure_pivot_acquisition_shutdown",
      "time_context",
      "provenance_rights_truth_and_uncertainty"
    ],
    "unknown_future_information_rule": {
      "action": "retain_in_universal_journal",
      "schema_ref": "schemas/foundation/journal-entry.v1.schema.json",
      "typing_policy": "progressive_typing",
      "promotion_rule": "When a recurring concept gains stable semantics, define a versioned typed/domain schema and backfill projections without deleting journal originals."
    },
    "source_required_for_capture": false,
    "missing_values": "unknown/unavailable/pending are valid; never coerce to zero or invent values",
    "product_field_rule": "Product output interfaces may guide enrichment but derived/presentation fields are not mandatory source facts and must not become universal storage boundaries.",
    "legacy_91_rule": "The historical 91-item business-case.v1 profile remains a deep research checklist. Its item count has no architectural significance and is not an allow-list."
  },
  "coverage": {
    "status": "REVIEW_REQUIRED",
    "pending": [],
    "reconciliation": {
      "status": "REVIEW_REQUIRED",
      "gaps": [
        "Exactly one collection_audit.v1 or collection_audit.v2 inventory required for DEEP reconciliation"
      ]
    },
    "note": "Intake and storage do not prove completeness. Reconciliation covers declared requirements and inventoried sources, not all information on the internet."
  },
