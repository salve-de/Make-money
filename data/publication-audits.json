   "analysis:a-headline": {
    "hash": "e09beea12493ae65e7733db7430d499da7c3dc334811f3f114a309a0e8041da6",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "登録フォームだけのページをHacker Newsに載せて数千人の待機客を集め、最初の相談は創業者が無料でメンター役を務めて始めた開発者向けの1対1相談所",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-story": {
    "hash": "daf427946c4c25a110410ae080c4bc432b014faaee759764c0b6b3457a536500",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "着想は、若手ばかりの自社エンジニアが設定の問題で2日止まったこと。2013年6月1日に登録フォームだけのページをHacker Newsに載せると数千人が待機リストに並んだが、製品は動いておらず、裏で作った。正式公開は約9か月後で、最初の実相談は創業者本人がメンター役を無料で務めた30分だった。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-customer_pain": {
    "hash": "7f498480e9885a436a779800545a0dd7f2ba4d43450c1d1958cfad72ff669c40",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "開発者が設定やコードで詰まった時に、すぐ呼べる経験者がいない。創業者はその場で数千ドル払ってもいいと感じた。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-first_customers": {
    "hash": "88b4aa1d75e124217ae3306b2722a21b74e7e82182b373fed0143bfaa4c51669",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "最初の相手は、Magento開発者でRuby on Railsを学びたい米国人。創業者が自分でメンター役をして無料で相談に乗った。以後は、少数の熱心なメンターを先に確保し、客には無料クレジットを配って使わせた。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-channels": {
    "hash": "8cbf49a725df4257657883f5da5e91214aa2987d8167970980e3e3df90bf229c",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "Hacker Newsの投稿が最初の集客。トップページに出て待機リストに数千人が登録し、コメントの助言（Clarity.fm方式の日程調整）も取り入れた。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-business_model": {
    "hash": "8c2d78b53ea54b3647abce8d33fffe04bd37121c69cf14963c3f351d091abfb4",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "客が前払いクレジットで有料セッションを買い、メンターの料金に別途サービス手数料を上乗せする。のちに、上位のメンターをフリーランス案件に紹介する市場を足した。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-pivots": {
    "hash": "6c8e7515c1484158d787a98ca774c5d80bf71f9bbd885a85be3d6a11729a041e",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "創業者は、当初は学習者向けの指導に近かったが、他の学習手段の隣に置く「必要な時に呼べる指導の層」と考え直したと語る。2016年には、フリーランス開発者を紹介する市場へ広げる方針を出した。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-failure_cause": {
    "hash": "09fc75dd4422beec808532442e86f6d15c2345543b0fbed6ad5b97d01938f579",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "創業者が挙げる反省は2点。WebRTCの不具合で開発時間を食ったこと、公開が約3か月遅れたこと。供給側が足りず、客を待たせると体験が悪くなる点も難所だった。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-capital_and_team": {
    "hash": "9d9a9a3bf638284864c7f07d2ea4eacc8b2d62bef4f4aac5c0f263c0f15da17e",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "元手は創業者の自己資金で始め、最初のシードは台湾の投資家。2016年12月までに早期資金120万ドル、シード160万ドルを調達した。",
     "formula": "調達額は、TechCrunchの記事にある120万ドルと160万ドルをそのまま載せた。"
    }
   },
   "analysis:a-competition": {
    "hash": "9f9ad3702b652b93be46324515970a032f6d7b41ca9e77db0e04436732c1be04",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "競合はFreelancer.com、Upwork、Toptalなどのフリーランス市場。創業者は、指導と選抜型の紹介市場の掛け合わせで違いを出すと語った。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-timeline": {
