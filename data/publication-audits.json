   "analysis:a-headline": {
    "hash": "daac13935b8193f98884c2e266f6b832304d83381a6db4a74098e7ab1e6c4114",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "自分用のRailsのメモを公開したサイトに集まった開発者へ動画を売り、毎週の無料動画で信頼を貯めて、1人のまま月約6万ドルに育てた元受託開発者",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-story": {
    "hash": "4bbe988afcf01832fa80edbd171b9b6fb1cd0c7ca4099f54b237e69fd519c6bc",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "受託で作った物が使われない虚しさから、2014年1月に仕事をやめた。最初の2コースは無名で売れず、資金が尽きかけた頃、毎週の無料動画がHacker Newsに載り、1日でメール600件超が集まった。そのメールに新作を知らせる形で有料の講座が回り始め、のちにホスティングとテンプレートへ広げた。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-business_model": {
    "hash": "6752ef1cf856d714bb290393b122f3b1ee622aa5ea4b5b626098d1e4e2c98838",
    "by": "data/audit/in-999999261008091237005.json",
    "body": {
     "text": "無料動画で名前を知ってもらい、メールの一覧に有料の講座を売る。同じ開発者層に、ホスティングとテンプレートという別の商品を重ねて売る。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-customer": {
    "hash": "20ae61981d9248e80a286b791019c09677c1e1da6155445ef6a130913a919cf6",
    "by": "data/audit/in-999999261008091237005.json",
    "body": {
     "text": "Railsを学ぶ初心者から、最新の書き方を追いたい経験者までの開発者。本人は、自分が毎日でも話したい相手に売れる点を強みに挙げている。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-first_customers": {
    "hash": "97d29cb91dbc685ed41b81aea84380fe149dbcf50c0f6326ba5f82a05c4d3964",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "最初の客は、メモ目的のサイトに既に来ていたRails開発者だった。有料コースだけでは売れず、無料動画を毎週出してメールを貯めた層が後の客になった。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-channels": {
    "hash": "b749dfc8ed2a56a1d56ffc2fc0a1cd125fafbdeb98174019eb4d53aea9bdb967",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "毎週の無料動画、ニュースレター、Hacker Newsの掲載、オープンソースのライブラリ、YouTubeとTwitterでの発信。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-capital_and_team": {
    "hash": "d3f3ca5f674f978fc8c60323a6779804c744ebf1fc39c12f6377247f4eae9b70",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "自己資金で始め、2014年1月の独立時は約9か月分の蓄えで、最初の2年は無給。2021年11月でも1人運営で、これから開発者とサポート担当を雇う段階だった。",
     "formula": "本人の説明（約9か月分の蓄え、2年間無給、2021年11月に1人運営）をそのまま記載"
    }
   },
   "analysis:a-why_it_worked": {
    "hash": "f5eb39c9dd5a1fb9a7d79cea33acf8c0c934878c933bfe7f422a9737e6c43232",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "先にアクセスのあるサイトを持ち、そこへ売ったことが、以前の「作ったが客がいない」失敗との違いだった。無料動画を毎週出して信頼を貯めた点も、本人が理由に挙げる。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-failure_cause": {
    "hash": "8a2f751a178dd9e80f8a5306c164fe9015553b34fd9bd0d04fc048663c40480e",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "最初の2コース（無料と有料）は、本人が無名で、受託の経験を商品に直しただけだったため売れなかったと本人は話す。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-lesson": {
    "hash": "6e2ae36f700128b61f50c31011af4b8b40c98ad9b614152fcafbb0273678dcd8",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "同じ層の人に次々と別の商品を売る。本人は、定期購入の歯ブラシ屋が歯磨き粉やカミソリを足していくのと同じだと説明する。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-timeline": {
    "hash": "c96b7322b3cea54d501d3b3e8dc142af6eb8cbbf19c756d27e986c1ea50eafa6",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "2014年1月に独立。その後、動画を毎週無料で公開し、Hacker Newsに載った日にメール600件超。2020年8月に3製品で累計100万ドル、2021年11月にMRR約6万ドル。",
     "formula": "数字は出典に載っている値"
    }
