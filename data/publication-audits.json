   "analysis:a-headline": {
    "hash": "5cdd5868b62a0bf7a021c8ce29959229b044ff2a87537c941e29829862b70351",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "5人・自己資金12ラック・ルピーで始め、半年で有料200社、3年目の年度に売上2百万ドルへ伸ばしたインドのクラウド電話屋",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-business_model": {
    "hash": "c4075ed44bfc971c2c6693339116e5aaa9a511242a08fa0819307b80ade16e80",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "中小企業にクラウド電話（IVR、番号、通話記録、振り分け）を年払いで売る。いまはWhatsAppとAIの応対ボットまで広げ、代理店経由の販売も用意している。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-customer_pain": {
    "hash": "7b4d0f7da390b5eaab587eaa570bc5e6543e33a5d4e6601fc7c3df166fc1efc3",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "創業者の見方では、インドの中小企業はメール以上の技術を使い慣れておらず、クラウド電話の存在自体が知られていなかった。そのため3年間は、売る前に説明して回る作業が重かった。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-referral": {
    "hash": "d18569030b59aa7b7b76005f54464dd5ebc9d928e7436d33e4acbaa0754cc504",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "代理店が顧客への運用サービスの値段を自分で決め、MyOperatorは代理店に基盤料金を請求する。固定の紹介料率は公開されていない。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-competition": {
    "hash": "ef6e82ad7d947768f3edc20a26cacdcc3c2610765de78aa1b9fa6eac14cc195d",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "競合のExotelとKnowlarityは資金調達や買収で規模を広げていた。MyOperatorは「設定なしで1分で立ち上がる」を違いに掲げた。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-capital_and_team": {
    "hash": "bd015188c98e1a6ba57463154f2c6211a1d950c7c47ef40a8a46cbf6057dd28a",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "元手は12ラック・ルピーで、主な使い道は技術開発とチーム。5人から125人まで増え、ESOPで従業員に報いている。",
     "formula": "元手12ラック・ルピー、人数5人→125人は、いずれも本人の説明（YourStory 2016年記事の再掲）をそのまま載せた。"
    }
   },
   "analysis:a-story": {
    "hash": "f4e458c8c1294adb67346d01662eb010ed5bf298d0af4ecb545f4a9a3b564077",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "CEOのAnkit Jainは2010年に最初の音声サービスVoice Jadooを始めていた。2013年3月、当時30歳のAnkitと27歳で公認会計士の弟Prateekが、自己資金12ラック・ルピーでMyOperatorを開始した。開始から6か月で登録利用者は600人超、有料は200社になり、この間に損益が釣り合った。開始からの3年間は、市場への啓発と販売に力を割いた。2016年時点で登録利用者は25,000人超、有料顧客は2,000社超、従業員は5人から125人に増えた。2016年時点で外部資金はなく、従業員にはストックオプションで報いた。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-customer": {
    "hash": "f8c7e21839e2f4d32dd3309bbe826ace6befe77b91f79e4d3689f8010cf3cfb6",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "小売・医療・教育・不動産・金融などの企業の営業・マーケ・サポート部門。開始から6か月の有料客にはLenskart、Snapdeal、Shop.IRCTCなど、2016年にはCanon、Fabindia、Cashkaro、DHLが加わった。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-first_customers": {
    "hash": "5dbab03c09438812f4432dba4c783233a0808b1d30c8c7449c6baed372dfc032",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "開始から6か月で登録利用者600人超、うち有料200社を得た。客にはアーム・アードミ党、Lenskart、Snapdeal、Shop.IRCTCなどがいた。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-channels": {
    "hash": "4bf4cb7644adba82be2448fc7c4b439989101ffbb1b6aa48b65ea45e29bcdc02",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "開始からの3年間は、市場への啓発と販売に力を割いたと創業者は語る。現在は代理店を通すパートナー制度があり、代理店が顧客向けの運用サービスの価格を決める。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-cost_structure": {
    "hash": "bc74ce8df7e032f933509dbbc6a8fdd0a29133b4345e3096c6f816597b571914",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "始めの12ラック・ルピーは主に技術とチームづくりに使った。従業員にはストックオプションで報いた。2016年時点の従業員は125人で、4割は直近6か月で採用した。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-dependencies": {
    "hash": "7d6fe47abc22d293e2b65ff5750b49a74dca1a222c557ae55ba476723fd7cc83",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
