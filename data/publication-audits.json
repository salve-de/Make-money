     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-upfront_cash": {
    "hash": "32f034799b7b3146472c320c211df276545bd04d0aeec7af2c7805db659c0cb8",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
