   "analysis:a-headline": {
    "hash": "06ce8ceef245be56cbe47757590446ae229f12e6cf64d9c4d60aa93f604ae1e0",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "広告も有料の壁も置かず、1年目に約65万人が読んだ組版の本を、自作フォントの売上で支えた書き手兼書体デザイナー",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-story": {
    "hash": "c8e044a78224b528876007b0c50ae2b37213e0b0a2c83b89b2dae72d44b946d4",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "名の通った出版社から紙の本の話が来たが、デザインを任せてもらえないと分かって断り、Webで自分で出した。読む前の支払いは求めず、役立ったなら払うか、自作フォントを買うかを選んでもらう形にした。1年目は65万人が読み、約650人に1人が払った。2年目は読者が増えたのに払う割合が下がり、3年目は無料の流入が集中する15〜20のサイトの読者にだけ、支払いのお願いを出して件数を2倍にした。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-business_model": {
    "hash": "e76865c4ca11edfab36c099578ea5ff0dbcd4fe69e60958ed40111090f33815c",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "本は無料で読ませ、読者が自分の制作で使いたくなる自作フォントと、直接の支払い、紙の本へつなぐ。稼ぎ頭はフォントで、直接の支払いだけでは続かなかったと本人が書く。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-customer": {
    "hash": "ba14fdbff0eb607ae7bb1ffddc7460050e1af0cd77b9c204c992c8e1538d0fe6",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "文書を美しく作りたい書き手、デザイナー、弁護士や開発者など幅広い読者。最も読まれたのは短くまとめた入門ページで、読者の大半は無料のまま読んで去る。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-cost_structure": {
    "hash": "35a4834e6dbc98affa3be6492e9e3dcb5ccb427df07ec0a656a16de22e2416f1",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "本人が費用として挙げるのは、執筆、フォント設計、図版、出版ソフトPollenの開発、サーバー代。広告・PR費はかけていない。金額は公開されていない。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-channels": {
    "hash": "4903557b70f06be711aed4e242719c53d1a591afead1324fcf59a6f1d9b98ce2",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "広告費をかけず、口コミが中心。2年目に多かった流入元はHacker News、Creative Bloq、Twitter、BuzzFeedのまとめ記事、Reddit。流入が多い元ほど払う人は少なく、Cool ToolsやDaring Fireballのような小さい流入元のほうが払う人の割合は高かった。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-capital_and_team": {
    "hash": "4a0a290c96b938656d4c131973c3a92008d66c56caffc87037613a1b68da1a53",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "文章、フォント、図版、出版ソフトまで、本人がすべて作った。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-dependencies": {
    "hash": "d35335e997a2498b4970097e91357c9c68378b0c469755bacf4a6e59f6d3e46f",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "無料の読者は少数のサイトからの流入に偏り、収入はフォント販売に強く寄っている。直接の支払いだけでは続かないと本人が書いている。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-competition": {
    "hash": "494935dddb4e1ec84547e6609db32b42d12d272c48e16b991610aa2f7e4befe5",
    "by": "data/audit/in-99999926100722513500175001.json",
    "body": {
     "text": "本人は比較の相手を紙の本に置き、平均的な教養書の生涯の取り分は合計5,000〜8,000ドル程度、1年目の直接の支払いは紙の1,200〜1,800部に当たると見ている。",
     "formula": "数字は出典に載っている値"
    }
   },
   "analysis:a-why_it_worked": {
