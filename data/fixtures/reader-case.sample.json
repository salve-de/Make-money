  "ent_vetta_f25db159678a": {
    "sources": [
      {
        "id": "s1",
        "publisher": "公式サイト",
        "url": "https://getvetta.ai",
        "checkedAt": "2026-09-29",
        "kind": "OFFICIAL"
      },
      {
        "id": "s2",
        "publisher": "Indie Hackers",
        "url": "https://www.indiehackers.com/product/vetta",
        "publishedAt": "2026-03-17",
        "checkedAt": "2026-09-29",
        "kind": "LISTING"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "kind": "DESCRIPTION",
        "text": "採用チームと候補者を、履歴書ではなく課題解決の成果でつなぐ採用マーケットプレイス。対象は採用チーム（5〜50人規模）、候補者、採用代行会社。",
        "sourceId": "s1",
        "attribution": "OFFICIAL"
      },
      {
        "id": "f2",
        "kind": "PRICING",
        "text": "候補者向けのプランは6か月$9.95（月あたり$1.70未満）のみ。雇用主・採用代行会社向けの料金は非掲載。",
        "sourceId": "s1",
        "attribution": "OFFICIAL"
      },
      {
        "id": "f3",
        "kind": "FOUNDING",
        "text": "運営は Vetta, Inc.。著作権表記は2026年。",
        "sourceId": "s1",
        "attribution": "OFFICIAL"
      },
      {
        "id": "f4",
        "kind": "TEAM",
        "text": "創業者は Richard Samela（@rsamela）。掲載ページのチーム表示は1人。",
        "sourceId": "s2",
        "attribution": "LISTING"
      },
      {
        "id": "f5",
        "kind": "EVENT",
        "text": "2026-03-17 の投稿で、9週間で候補者4,400人超、企業55社、成約11件を報告。2026-08-29 の投稿で、約8か月で候補者約6,000人、企業80社、成約180件超、採用までの平均13日を報告（いずれも本人申告）。",
        "sourceId": "s2",
        "statedAt": "2026-08-29",
        "attribution": "SELF_REPORTED"
      }
    ],
    "metrics": [
      {
        "id": "m1",
        "measure": "REVENUE",
        "periodKind": "MONTH",
        "period": "月",
        "amount": 23000,
        "currency": "USD",
        "origin": "SELF_REPORTED",
        "basis": "Indie Hackers 掲載ページの収益欄の表示",
        "sourceId": "s2",
        "statedAt": "2026-09-29"
      }
    ],
