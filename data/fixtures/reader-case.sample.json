        "kind": "OFFICIAL"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "kind": "DESCRIPTION",
        "text": "Baremetricsは決済データからMRR、ARR、解約率、顧客価値などを表示し、回収・解約分析も提供する。",
        "sourceId": "s1",
        "attribution": "OFFICIAL"
      },
      {
        "id": "f2",
        "kind": "PRICING",
        "text": "料金は追跡対象ARRに応じて増え、支払回収や解約分析などの追加製品も選べる。",
        "sourceId": "s2",
        "attribution": "OFFICIAL"
      },
      {
        "id": "f3",
        "kind": "FOUNDING",
        "text": "Josh Pigfordは2013年にBaremetricsを作り、同年11月にStripe向け分析として公開した。",
        "sourceId": "s4",
        "attribution": "OFFICIAL"
      },
      {
        "id": "f4",
        "kind": "EXIT",
        "text": "2020年11月、Josh PigfordはXenon Partnersへ現金4百万ドルで売却し、本人受取額3.7百万ドル、約2.65倍ARRと公表した。",
        "sourceId": "s3",
        "statedAt": "2020-11-10",
        "attribution": "OFFICIAL"
      }
    ],
    "metrics": [
      {
        "id": "m1",
        "measure": "EXIT_VALUE",
        "periodKind": "POINT",
        "period": "2020年11月",
        "amount": 4000000,
        "currency": "USD",
        "origin": "SELF_REPORTED",
        "sourceId": "s3",
        "statedAt": "2020-11-10"
      }
    ],
    "unknowns": [
      "REVENUE",
      "PROFIT",
      "COST",
      "CHANNEL",
      "TOOLS"
    ],
    "summaryFactId": "f1"
  },
  "ent_ebizfacts_hannahmorganvirtualhousemanager60kyear_bc927cae9842": {
    "sources": [
      {
        "id": "s1",
        "publisher": "eBiz Facts",
        "url": "https://ebizfacts.com/hannah-morgan-virtual-house-manager-60k-year/",
        "publishedAt": "2025-07-31",
        "checkedAt": "2026-09-29",
        "kind": "ARTICLE"
      },
      {
        "id": "s2",
        "publisher": "Side Hustle Nation",
        "url": "https://www.sidehustlenation.com/virtual-house-management/",
        "checkedAt": "2026-09-29",
        "kind": "THIRD_PARTY"
      }
    ],
    "facts": [
      {
        "id": "f1",
        "kind": "DESCRIPTION",
        "text": "夏のキャンプの申込み、医者の予約、家族旅行の計画、家族の予定管理など、家庭の雑務をオンラインで代行するHeron House Managementを運営する。開始から1年余り。",
        "sourceId": "s1",
        "attribution": "ARTICLE"
      },
      {
        "id": "f2",
        "kind": "TEAM",
        "text": "本人とチームで運営し、全員がリモート勤務。",
        "sourceId": "s1",
        "attribution": "ARTICLE"
      },
      {
        "id": "f3",
        "kind": "OTHER",
        "text": "利用者の子どもの年齢・興味・予算を聞き、11週間の夏休みのキャンプ手配などを行う使い方が紹介されている。",
        "sourceId": "s1",
        "attribution": "ARTICLE"
      }
    ],
    "metrics": [
      {
        "id": "m1",
        "measure": "REVENUE",
        "periodKind": "YEAR",
        "period": "昨年",
        "amount": 60000,
        "currency": "USD",
        "origin": "ARTICLE",
        "sourceId": "s1",
        "statedAt": "2025-07-31"
      }
    ],
    "unknowns": [
      "PROFIT",
      "COST",
      "CHANNEL",
      "TOOLS",
      "PRICING",
      "STATUS"
    ]
  },
