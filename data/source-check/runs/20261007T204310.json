[
 {
  "key": "ent_rfrcui_64e924ac|fact|f1",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f1",
  "text": "開発者が自分で画面を整えられるようにするデザイン教材。218ページのPDF（50章）、3本の動画（合計約41分）、200点超の部品見本、十数種の配色、30超のフォント案、200点のSVGアイコンが一式になっている。",
  "textHash": "0f9e8892",
  "sourceUrl": "https://refactoringui.com/",
  "quote": "The 218-page book in PDF format",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f2",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f2",
  "text": "価格は、本と動画だけのEssentialsが99ドル、素材まで全部入りのComplete Packageが149ドル（いずれも税別）。チーム向けはComplete Packageが3人399ドル、5人649ドル、10人1,249ドル、25人2,749ドルなどの人数別。",
  "textHash": "578a7ee8",
  "sourceUrl": "https://refactoringui.com/",
  "quote": "The Essentials\n$99\nUSD\nplus local taxes",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f3",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f3",
  "text": "著者はAdam Wathan（開発者）とSteve Schoger（UIデザイナー）。長年の友人で、共作の副業ではSteveが画面設計、Adamが開発を受け持っていた。",
  "textHash": "b9a3fb63",
  "sourceUrl": "https://refactoringui.com/",
  "quote": "him handling the UI design and me taking care of development",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f4",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f4",
  "text": "当初は、2人がTwitterで配ってきた小技を1つにまとめるだけの予定だった。計画を進めるうちに、本だけでなく動画・部品見本・配色・フォント・アイコンまで含む「一式」に広げた。",
  "textHash": "92420d2d",
  "sourceUrl": "https://refactoringui.com/",
  "quote": "take all of the tips and tricks we’ve shared on Twitter , bundle them up into one resource, and put it out into the world.",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f5",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f5",
  "text": "売り文句は「才能ではなく手順」。例として、枠線を減らし、影・背景色の差・余白で要素を分ける方法を挙げる。多くのデザイン講座は色彩理論などの大きな原則に偏り、すぐ画面を良くする具体策が足りないと批判している。",
  "textHash": "8159e81d",
  "sourceUrl": "https://refactoringui.com/",
  "quote": "They focus so much on high level principles like color theory and typography",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f6",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f6",
  "text": "発売前の約2年、ツイートを多く流した。1本に2週間近いほぼフルタイムの作業をかけたものも多く、5000リツイート・1万5千いいね前後に届いた。記事「7 Practical Tips for Cheating at Design」は、長い間Mediumで歴代1位の記事だったという。",
  "textHash": "65484087",
  "sourceUrl": "https://www.indiehackers.com/post/im-adam-wathan-i-created-tailwind-css-and-built-a-multi-million-dollar-business-around-it-ama-3c0732f724",
  "publishedAt": "2022-09",
  "quote": "Many of those tweets took two weeks of near full-time effort to craft and make perfect, but that's why they would get like 5000 RTs and 15,000 likes.",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f7",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f7",
  "text": "Refactoring UIは2018年12月に書いた本で、2022年9月の投稿時点で累計250万ドル超。4年たっても売れ続けていると本人が書いている。",
  "textHash": "70bb214a",
  "sourceUrl": "https://www.indiehackers.com/post/im-adam-wathan-i-created-tailwind-css-and-built-a-multi-million-dollar-business-around-it-ama-3c0732f724",
  "publishedAt": "2022-09",
  "quote": "In December 2018, I wrote Refactoring UI with my friend Steve Schoger, which has done over $2.5m and continues to sell well four years later.",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f8",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f8",
  "text": "Adamは教材の前にも実績があった。2016年の最初の本は発売初週に61,392ドル、同年のTDD講座は累計100万ドル超、2018年のVue講座は約30万ドルと本人が書いている。2019年1月からTailwind CSSに専念し、2020年にTailwind UIを出した。",
  "textHash": "ad12a769",
  "sourceUrl": "https://www.indiehackers.com/post/im-adam-wathan-i-created-tailwind-css-and-built-a-multi-million-dollar-business-around-it-ama-3c0732f724",
  "publishedAt": "2022-09",
  "quote": "I went solo after writing my first book in 2016, which did $61,392 in the first week",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f9",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f9",
  "text": "Adamが実際に出して失敗したのはNitpick CIだけで、履歴書アプリ、リンク共有のSNS、売上税の徴収を代行する決済サービスは、完成させずにやめたと本人が答えている。",
  "textHash": "a4fdcd78",
  "sourceUrl": "https://www.indiehackers.com/post/im-adam-wathan-i-created-tailwind-css-and-built-a-multi-million-dollar-business-around-it-ama-3c0732f724",
  "publishedAt": "2022-09",
  "quote": "The only real failure that I actually launched was Nitpick CI, all of my other failed projects I actually failed to finish/launch",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f10",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f10",
  "text": "発売当初の価格は、基本版79ドル・上位版149ドルだった。上位版の値引きを40%、基本版を25%と見せ、上位版を大きく目立つ見た目にしたところ、2019年1月10日時点の購入の約78%が上位版だったという。",
  "textHash": "16042437",
  "sourceUrl": "https://marketingexamples.com/landing-page/pricing",
  "quote": "78% of total purchases (6765) favoured the higher tier (as of Jan 10, 2019)",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f11",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f11",
  "text": "同記事は、2年分の無料のツイート・動画・記事があったから149ドルを付けられた、と分析している。Amazonの電子書籍の相場から外れるよう、自前のサイトで動画・素材と組にした点も挙げる。",
  "textHash": "0843c3a1",
  "sourceUrl": "https://marketingexamples.com/landing-page/pricing",
  "quote": "Only in serving up two years worth of free tips, screencasts, and articles is this price possible.",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
 {
  "key": "ent_rfrcui_64e924ac|fact|f13",
  "entityId": "ent_rfrcui_64e924ac",
  "kind": "fact",
  "id": "f13",
  "text": "公式サイトは3万部超の販売、Goodreads評価4.68、SavvyCal・Clearbit・Transistorの創業者の推薦文を掲げる。購入は2つの価格帯の「Buy now」から。決済はLink by Stripe。",
  "textHash": "b8a85b99",
  "sourceUrl": "https://refactoringui.com/",
  "quote": "Over 30,000 copies sold\n4.68 stars on Goodreads",
  "status": "PASS",
  "reasons": [],
  "detail": [],
  "via": "direct",
  "retried": false
 },
