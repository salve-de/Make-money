# Storage architecture: docs/architecture/STORAGE.md
# Cloudflare Workers uses APP_DB / APP_R2 bindings in wrangler.jsonc.
# Plain Node single-statement D1 access needs explicit credentials below.
# Multi-statement transactions require the APP_DB binding; no Neon fallback.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
APP_D1_DATABASE_ID=""
APP_R2_BUCKET=""

# Authentication (Firebase Auth)
# Worker runtime uses the non-secret FIREBASE_PROJECT_ID var in wrangler.jsonc.
# The deploy preflight requires the four NEXT_PUBLIC values below and refuses placeholders.
FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:000000000000"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# AI & Live Web Search (Google AI Studio - Free Tier / Pay-as-you-go)
# 利用枠・料金はプロバイダーの現行契約を確認する。
GEMINI_API_KEY="AIzaSy..."

# Storage (Cloudflare R2 - server-side S3-compatible access)
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://assets.yourdomain.com"

# Universal Foundation ingestion targets. Do not set these to legacy `universal`.
FOUNDATION_R2_RAW_BUCKET="foundation-raw"
FOUNDATION_R2_LAKE_BUCKET="foundation-lake"
FOUNDATION_R2_RESTRICTED_BUCKET="foundation-restricted"
FOUNDATION_R2_PUBLIC_BUCKET="foundation-public"
# Required by the internal POST /api/foundation/ingest endpoint.
FOUNDATION_INGEST_TOKEN="replace-with-a-long-random-server-only-token"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
