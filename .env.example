# Storage architecture: docs/architecture/STORAGE.md
# Cloudflare Workers uses APP_DB / APP_R2 bindings in wrangler.jsonc.
# Plain Node single-statement D1 access needs explicit credentials below.
# Multi-statement transactions require the APP_DB binding; no Neon fallback.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
APP_D1_DATABASE_ID=""
APP_R2_BUCKET=""

# Authentication (Firebase Auth)
# Worker runtime uses the non-secret FIREBASE_PROJECT_ID var in wrangler.jsonc.
# The deploy preflight requires the four NEXT_PUBLIC values below and refuses placeholders.
FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:000000000000"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Plans (src/lib/payments/README.md). Monthly/yearly prices are decided only here, in whole JPY.
# Unset, empty, 0, decimal or comma-separated values mean "that plan is not sold".
# PRO_MONTHLY_PRICE_JPY=""
# PRO_YEARLY_PRICE_JPY=""
# Set to 0 only to stop selling the one-time founding pass.
# FOUNDING_PASS_ENABLED="1"

# AI App Builder (v0 Platform API - server side only; never expose as NEXT_PUBLIC_*)
V0_API_KEY=""
# Hard server-side spend guard. v0 API credit units; defaults to 5 when omitted.
BUILDER_DAILY_CREDIT_LIMIT="5"

# AI & Live Web Search (Google AI Studio - Free Tier / Pay-as-you-go)
# 利用枠・料金はプロバイダーの現行契約を確認する。
GEMINI_API_KEY="AIzaSy..."

# Storage (Cloudflare R2 - server-side S3-compatible access)
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://assets.yourdomain.com"
# Official product images (docs/MEDIA_ASSETS_AND_PROVENANCE.md, chapter 11). In production the site shows an image only when
# CLOUDFLARE_R2_PUBLIC_DOMAIN serves the foundation-public bucket (media/<entityId>/...) and the image is listed in its public manifest.
# Optional: MEDIA_SOURCE=local_staging | foundation_public | off   (default: local_staging under `next dev`, foundation_public otherwise)
# Optional: MEDIA_STAGING_DIR=/absolute/path/to/data/media-staging

# Universal Foundation ingestion targets. Do not set these to legacy `universal`.
FOUNDATION_R2_RAW_BUCKET="foundation-raw"
FOUNDATION_R2_LAKE_BUCKET="foundation-lake"
FOUNDATION_R2_RESTRICTED_BUCKET="foundation-restricted"
FOUNDATION_R2_PUBLIC_BUCKET="foundation-public"
# Required by the internal POST /api/foundation/ingest endpoint.
FOUNDATION_INGEST_TOKEN="replace-with-a-long-random-server-only-token"

# Notification email (docs/NOTIFICATIONS.md). Names only here: set the values as host secrets.
# Without RESEND_API_KEY and NOTIFY_FROM_EMAIL the digest sends nothing and answers "email_not_configured".
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL=""
NOTIFY_CRON_SECRET=""
# Optional: signs newsletter stop links so NOTIFY_CRON_SECRET can be rotated without breaking old emails.
NOTIFY_UNSUBSCRIBE_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
