# Current legacy static prototype can run without external environment variables.
# Target production stack: Cloudflare Workers + Neon + Firebase Auth + Stripe (+ R2 when needed).

# Neon PostgreSQL
DATABASE_URL=

# Firebase Auth - public client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase server-side verification/configuration.
# Exact credential form must match the Workers-compatible implementation chosen during migration.
FIREBASE_PROJECT_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare R2 - only when object/file storage is used
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Supabase is intentionally not part of the target production stack.
