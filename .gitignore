# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.open-next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example


# vercel
.vercel

# worktrees
.worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# backups
.backups/
scratch/

# cloudflare wrangler
.wrangler/


# Playwright reports and traces
/playwright-report/
/test-results/
/blob-report/

# Local R2 CAS Mirror
/data/r2-local/

# Python recovery verification cache
__pycache__/

# Raw sources cache and master facts cache
/data/raw_master_facts.json
/data/raw_sources_cache/
/.catalog-release/

# Private re-audit research candidates and worker notes (kept in R2 backup / private worktree, never pushed)
/data/incoming/reaudit-*.json
/reports/reaudit-*
/reports/paused-handoff-*
# Media asset staging (fetched images and provenance manifests; local only, see docs/MEDIA_ASSETS_AND_PROVENANCE.md)
/data/media-staging/

# Re-audit lane scratch (LANE_WORKDIR default; local only, see docs/reaudit/)
/.reaudit-work/

# 出典本文の照合（scripts/reader-case/fetch-sources.ts など）。結果の data/reader-verdicts.json だけコミットする
/data/source-cache/
/data/verify/
# 推論（reader.analysis）の作業ファイル。結果の data/reader-analysis.json だけコミットする
/data/analyze/
# 事例担当の作り直しを経路の入力へ変換した作業物（scripts/reader-case/import-case-rebuild.ts）。結果は経路を通してから data/ の正本に入る
/data/case-import/
# サブエージェント実行層の作業ファイル（指示書・結果の受け皿・試行状態）
/data/runner/
# 収集の状態台帳（追記型。ローカルのみ）
/data/pipeline/ledger/
# 画面の層の自動作成（pnpm display:build）の作業記録と、通らなかった事例の理由。ローカルのみ
/data/pipeline/display-build/
/data/pipeline/display-build-failures.jsonl
/data/pipeline/natural-japanese-candidates.jsonl

# pnpm case:run の実行記録（所要時間・各命令の出力・画面の文の作業場所）
/data/pipeline/case-run/
/data/pipeline/case-run.jsonl
